}
QToolButton#btnSettings, QToolButton#btnCamera {
  background-color: #ffffff;
  border: 1px solid #dbe7f3;
  border-radius: 16px;
  color: #1e293b;
  font-size: 18px;
  font-weight: bold;
  padding: 8px;
}
QToolButton#btnSettings:pressed, QToolButton#btnCamera:pressed {
  background-color: #e0f2fe;
}
QLabel#titleStatus, QLabel#titleSpeed, QLabel#titleBattery, QLabel#titleOdo {
  color: #64748b; font-size: 12px;
}
QLabel#labelSpeed, QLabel#labelBattery, QLabel#labelOdo {
  color: #0f172a; font-size: 20px; font-weight: bold;
}
QLabel#footerLabel, QLabel#datelable, QLabel#timelable { color: #64748b; font-size: 13px; }
